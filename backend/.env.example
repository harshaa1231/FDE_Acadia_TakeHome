# Copy this file to .env and fill in your own Groq API key (free tier):
# https://console.groq.com/keys
GROQ_API_KEY=

# Models used by the NL pipeline (Groq model names). Defaults shown.
SQL_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b

# Where ingested dataset stores (DuckDB files) live on disk.
DATA_DIR=./data_store

# Tunables - defaults are sane for local/dev use.
MAX_UPLOAD_MB=200
MAX_RESULT_ROWS=500
SQL_EXECUTION_TIMEOUT_S=15
JOB_WORKER_CONCURRENCY=4
